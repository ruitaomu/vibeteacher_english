/* pages/vocabulary/vocabulary.wxss */

.container {
  padding: 32rpx 24rpx 120rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.search-box {
  margin-bottom: 24rpx;
}

.search-input {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  width: 100%;
  box-sizing: border-box;
}

.loading-box,
.empty-box {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
}

.count-row {
  margin-bottom: 16rpx;
}

.vocab-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.vocab-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.vocab-word {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.vocab-translation {
  font-size: 28rpx;
  color: #4338ca;
  margin-bottom: 10rpx;
}

.vocab-example {
  font-size: 24rpx;
  line-height: 1.6;
  font-style: italic;
}

.example-label {
  font-style: normal;
  font-weight: 600;
  margin-right: 4rpx;
}
