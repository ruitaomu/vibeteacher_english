/* pages/index/index.wxss */

.container {
  padding: 32rpx 24rpx 120rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 10rpx;
}

.form-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 28rpx;
}

.picker-value {
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea-sm {
  min-height: 120rpx;
}

.result-text {
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  display: block;
}

.issue-item {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #f9fafb;
}

.issue-row {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.issue-label {
  font-weight: 600;
  margin-right: 8rpx;
  white-space: nowrap;
}

.vocab-item {
  border-left: 6rpx solid #2563eb;
  padding: 16rpx 0 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.vocab-word {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.vocab-translation {
  font-size: 26rpx;
  color: #4338ca;
  margin-top: 6rpx;
}

.vocab-example {
  font-size: 24rpx;
  margin-top: 8rpx;
  font-style: italic;
}

.btn-link {
  background: none;
  color: #2563eb;
  font-size: 26rpx;
  padding: 12rpx 0;
  margin-top: 8rpx;
  text-align: left;
  border: none;
}

.achievement-banner {
  border-left: 6rpx solid #f59e0b;
}

.achievement-new {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.achievement-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.achievement-name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.achievement-desc {
  display: block;
  margin-top: 4rpx;
}
