.container {
  padding: 32rpx 24rpx 120rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label,
.sentence-label,
.learn-title {
  font-size: 26rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 10rpx;
}

.picker-value {
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.ocr-toolbar {
  margin-bottom: 16rpx;
}

.ocr-button {
  width: 100%;
  border: 1rpx dashed #93c5fd;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 28rpx;
}

.ocr-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.ocr-status {
  margin-bottom: 16rpx;
}

.result-text {
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  display: block;
}

.sentence-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.sentence-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.sentence-head,
.action-row {
  margin-bottom: 12rpx;
}

.sentence-block {
  margin-bottom: 16rpx;
}

.mini-action {
  margin: 0;
}

.structure-box {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin: 12rpx 0 20rpx;
}

.learn-section {
  margin-top: 18rpx;
}

.learn-item {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  margin-bottom: 14rpx;
}

.learn-main {
  margin-bottom: 14rpx;
}

.learn-term {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.learn-explanation {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #374151;
}

.learn-example {
  display: block;
  margin-top: 8rpx;
  line-height: 1.6;
}

.add-button {
  width: 220rpx;
}
