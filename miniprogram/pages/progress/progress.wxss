/* pages/progress/progress.wxss */
.page-scroll {
  height: 100vh;
}

.page-hero {
  padding-bottom: 24rpx;
}

.login-card {
  margin: 0 16rpx 20rpx;
}

.login-button {
  margin-top: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.stats-row {
  display: flex;
  flex-direction: row;
  padding: 0 16rpx;
}

.stat-card {
  flex: 1;
  text-align: center;
  margin: 10rpx 8rpx;
  padding: 28rpx 16rpx;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #2563eb;
  line-height: 1.1;
}

.streak-value {
  color: #ea580c;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.streak-best {
  font-size: 40rpx;
  font-weight: 700;
  color: #ea580c;
}

.date-text {
  font-size: 32rpx;
  color: #1f2937;
  font-weight: 500;
}

.achievement-count {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.view-all {
  font-size: 26rpx;
  color: #2563eb;
  margin-top: 8rpx;
}

.tip-card {
  margin-top: 4rpx;
}

.history-card {
  margin-top: 4rpx;
}

.history-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.history-time {
  font-size: 24rpx;
  color: #4b5563;
}

.history-level {
  font-size: 22rpx;
  color: #1d4ed8;
  background: #e0ecff;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.history-block {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.history-label {
  font-size: 23rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.history-text {
  font-size: 27rpx;
  color: #111827;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.history-pager {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pager-btn {
  min-width: 150rpx;
}

.pager-info {
  font-size: 24rpx;
  color: #4b5563;
}

.tip-item {
  font-size: 28rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  line-height: 1.5;
}

.tip-item:last-child {
  border-bottom: none;
}

.center-text {
  text-align: center;
}
