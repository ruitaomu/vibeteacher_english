/* pages/achievements/achievements.wxss */

.container {
  padding: 32rpx 24rpx 120rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.loading-box {
  text-align: center;
  padding: 80rpx 0;
}

.stats-card {
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  min-width: 140rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #2563eb;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
  display: block;
}

.achievement-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.achievement-row:last-child {
  border-bottom: none;
}

.achievement-row.locked {
  opacity: 0.5;
}

.achievement-icon-box {
  width: 80rpx;
  text-align: center;
  flex-shrink: 0;
}

.achievement-icon {
  font-size: 48rpx;
}

.achievement-content {
  flex: 1;
  margin-left: 20rpx;
}

.achievement-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
}

.achievement-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
  display: block;
}

.earned-badge {
  font-size: 22rpx;
  color: #059669;
  background: #d1fae5;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
