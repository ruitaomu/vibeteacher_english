.loading-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.16);
}

.loading-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 34rpx 42rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.18);
  backdrop-filter: blur(10px);
}

.loading-icon {
  font-size: 74rpx;
  line-height: 1;
  opacity: 0.82;
  animation: loading-overlay-spin 1.2s linear infinite;
}

.loading-text {
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #1f2937;
}

@keyframes loading-overlay-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
